# 依赖
node_modules/
# 数据库文件（不要提交本地数据）
*.db
*.db-shm
*.db-wal
# 构建产物
dist/
# 日志
*.log
# 系统文件
.DS_Store
# Vite 配置加载时生成的临时文件
*.timestamp-*.mjs
# 本机专用的一键启动脚本（路径写死，不进仓库）
start-backend.cmd
# 本地备份（换库前留的旧数据）
_backup/
# 测试覆盖率报告
coverage/
# 用户上传的图片（运行时产物，不进仓库）。
# 仓库留一个 .gitkeep 保住目录结构，部署时目录能被创建出来。
backend/uploads/*
!backend/uploads/.gitkeep
